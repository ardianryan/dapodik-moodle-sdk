  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Ryan Ardian",
      "email": "inisaya@ardianryan.com",
      "role": "Developer"
    },
    {
      "name": "SMA Negeri 1 Gedeg",
